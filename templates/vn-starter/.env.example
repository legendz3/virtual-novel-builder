# Both Supabase values may be blank for an offline/guest-only build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Optional PostHog analytics. Use only the public project token (phc_), never a personal API key.
# Enable in Production only. Local verification events are marked environment=test.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=false
