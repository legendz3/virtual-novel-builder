{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@game/*": ["./src/game/*"],
      "@content/*": ["./src/content/*"]
    }
  },
  "include": ["vite.config.ts", "playwright.config.ts"]
}
